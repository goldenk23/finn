# Option 1: Gemini Developer API Key
GEMINI_API_KEY=your_api_key_here

# Option 2: Google Cloud Vertex AI (Application Default Credentials)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# GOOGLE_CLOUD_LOCATION=global

# --- Public deployment guards (all optional for local dev) ---
# Paid AI endpoints return HTTP 429 once today's llm_cost_ledger spend (UTC day) reaches this.
# FINN_DAILY_BUDGET_USD=5.00
# If set, force=true Pull regeneration, /api/push/refresh and /api/push/enrich require header X-Admin-Token.
# FINN_ADMIN_TOKEN=generate-a-long-random-string
# Trusted proxies in front of the app that append to X-Forwarded-For (Dockerfile sets 1). 0 = use the socket peer.
# FINN_PROXY_HOPS=0
# Background Push refresh (prices + filings + triage, paid LLM calls) every N minutes while the server runs.
# Unset/0/invalid = off. Single uvicorn worker only: each worker would start its own loop.
# FINN_REFRESH_MINUTES=30
# Only needed if the frontend is hosted on a different origin (comma-separated).
# FINN_CORS_ORIGINS=*

# --- Frontend ---
# Backend location for the browser and the dev rewrite. Leave empty for same-origin.
# NEXT_PUBLIC_API_URL=
