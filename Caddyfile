{
	default_sni 13.233.140.42
}

# One JSON line per request (time, client IP, method, path, status, user agent) in the caddy_data volume,
# so it survives restarts and rebuilds. Read it with: sudo python3 scripts/visitors.py
(access_log) {
	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 10
		}
		format json
	}
}

{$FINN_DOMAIN::80} {
	import access_log
	tls {
		key_type rsa2048
	}
	encode zstd gzip

	reverse_proxy finn:8000 {
		transport http {
			read_timeout 180s
			write_timeout 180s
			response_header_timeout 180s
		}
	}
}
http://13.233.140.42, :80 {
	import access_log
	encode zstd gzip

	reverse_proxy finn:8000 {
		transport http {
			read_timeout 180s
			write_timeout 180s
			response_header_timeout 180s
		}
	}
}
https://13.233.140.42 {
	import access_log
	tls {
		key_type rsa2048
		issuer acme {
			profile shortlived
		}
	}
	encode zstd gzip

	reverse_proxy finn:8000 {
		transport http {
			read_timeout 180s
			write_timeout 180s
			response_header_timeout 180s
		}
	}
}
