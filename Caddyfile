{$FINN_DOMAIN::80} {
	tls {
		key_type rsa2048
	}
	encode zstd gzip

	reverse_proxy finn:8000 {
		transport http {
			read_timeout 180s
			write_timeout 180s
			response_header_timeout 180s
		}
	}
}
